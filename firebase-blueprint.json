{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile with role-based access",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "mssv": { "type": "string" },
        "branch": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "chidoan", "doanvien"] },
        "avatar": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "bch_member": {
      "title": "BCH Member",
      "description": "Executive committee member profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "role", "avatar", "createdAt"]
    },
    "activity": {
      "title": "Activity",
      "description": "An organized event or campaign",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "pointsParticipant": { "type": "number" },
        "pointsOrganizer": { "type": "number" },
        "branch": { "type": "string" },
        "targetAudience": { "type": "string" },
        "semester": { "type": "number", "enum": [1, 2, 3] },
        "academicYear": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "planLink": { "type": "string" },
        "evidenceLink": { "type": "string" },
        "creatorId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "startTime", "endTime", "pointsParticipant", "pointsOrganizer", "targetAudience", "semester", "academicYear", "status", "creatorId", "createdAt", "updatedAt"]
    },
    "registration": {
      "title": "Registration",
      "description": "User's registration for an activity",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "activityId": { "type": "string" },
        "status": { "type": "string", "enum": ["registered", "attended", "organizer"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "activityId", "status", "createdAt"]
    },
    "notification": {
      "title": "Notification",
      "description": "System notification message",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "targetAudience": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "message", "targetAudience", "createdAt"]
    },
    "handbook_topic": {
      "title": "Handbook Topic",
      "description": "Knowledge handbook article",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "content", "order"]
    },
    "youth_idea": {
      "title": "Youth Idea",
      "description": "Creative idea or initiative submitted by union members",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "mssv": { "type": "string" },
        "branch": { "type": "string" },
        "email": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "problemStatement": { "type": "string" },
        "solutionProposal": { "type": "string" },
        "expectedImpact": { "type": "string" },
        "attachmentLink": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "implemented", "featured", "rejected"] },
        "adminFeedback": { "type": "string" },
        "upvotes": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "authorName", "title", "category", "solutionProposal", "status", "createdAt", "updatedAt"]
    },
    "tntt_application": {
      "title": "TNTT Application",
      "description": "Application for Thanh niên tiên tiến làm theo lời Bác & Tập thể tiên tiến làm theo lời Bác",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "applicantType": { "type": "string", "enum": ["individual", "collective"] },
        "awardLevel": { "type": "string", "enum": ["truong", "tieubieu"] },
        "personRole": { "type": "string", "enum": ["sinhvien", "canbogiangvien"] },
        "fullName": { "type": "string" },
        "mssv": { "type": "string" },
        "branch": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "unionRating": { "type": "string" },
        "uncleHoPracticeWork": { "type": "string" },
        "drlScore": { "type": "string" },
        "drlEvidenceLink": { "type": "string" },
        "gpaScore": { "type": "string" },
        "gpaEvidenceLink": { "type": "string" },
        "primaryCategory": { "type": "string" },
        "folderEvidenceLink": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved_faculty", "proposed_exemplary", "needs_revision", "rejected"] },
        "reviewerNote": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "applicantType", "awardLevel", "fullName", "branch", "primaryCategory", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "User profiles"
    },
    "/bch_members/{memberId}": {
      "schema": { "$ref": "#/entities/bch_member" },
      "description": "Executive committee members"
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/activity" },
      "description": "Activities"
    },
    "/activities/{activityId}/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/registration" },
      "description": "Registrations and attendances for an activity"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/notification" },
      "description": "System notifications"
    },
    "/handbook_topics/{topicId}": {
      "schema": { "$ref": "#/entities/handbook_topic" },
      "description": "Handbook topics"
    },
    "/youth_ideas/{ideaId}": {
      "schema": { "$ref": "#/entities/youth_idea" },
      "description": "Creative ideas and initiatives contributed by union members"
    },
    "/tntt_applications/{applicationId}": {
      "schema": { "$ref": "#/entities/tntt_application" },
      "description": "Applications for Thanh niên tiên tiến làm theo lời Bác"
    }
  }
}
