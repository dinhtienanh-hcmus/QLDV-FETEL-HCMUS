rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Role checks
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      // Check from user doc directly or email
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Alternatively, verify role from user document
    function getUserRole() {
       return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isBranchManager() {
       return isSignedIn() && getUserRole() == 'chidoan';
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 256 &&
             data.role is string && data.role in ['admin', 'chidoan', 'doanvien'] &&
             data.createdAt is number;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['name', 'time', 'points', 'targetAudience', 'creatorId', 'createdAt']) &&
             data.name is string && data.name.size() <= 256 &&
             data.time is string && data.time.size() <= 64 &&
             data.points is number &&
             data.targetAudience is string && data.targetAudience.size() <= 64 &&
             data.creatorId is string && data.creatorId.size() <= 128 &&
             data.createdAt is number;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['userId', 'status']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.status is string && data.status in ['registered', 'attended'];
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().role == 'doanvien'; // Only self-register as doanvien
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'branch', 'mssv']))
      );
      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(activityId) && isValidActivity(incoming()) && (
        isAdmin() ||
        (isBranchManager() && incoming().creatorId == request.auth.uid)
      );
      allow update: if isSignedIn() && isValidActivity(incoming()) && (
        isAdmin() ||
        (isBranchManager() && existing().creatorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'time', 'points', 'targetAudience']))
      );
      allow delete: if isAdmin() || (isBranchManager() && existing().creatorId == request.auth.uid);

      match /registrations/{registrationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(registrationId) && isValidRegistration(incoming()) && (
          (isOwner(incoming().userId) && incoming().status == 'registered') ||
          (isAdmin() && incoming().status == 'attended') ||
          (isBranchManager() && incoming().status == 'attended')
        );
        allow update: if isSignedIn() && isValidRegistration(incoming()) && (
          isAdmin() ||
          (isBranchManager() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'scannedAt', 'scannedBy']))
        );
        allow delete: if isAdmin() || isOwner(existing().userId);
      }
    }
  }
}
