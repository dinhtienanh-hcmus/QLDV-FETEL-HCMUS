rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Role checks
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in ['dkdtvt.hcmus@gmail.com', 'dinhtienanh.hcmus@gmail.com', 'dinhtienanh235@gmail.com']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function getUserRole() {
       return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isBranchManager() {
       return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'chidoan';
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
             data.email is string && data.email.size() >= 1 && data.email.size() <= 256 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 256 &&
             data.role is string && data.role in ['admin', 'chidoan', 'doanvien'] &&
             data.createdAt is number;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['name', 'startTime', 'endTime', 'pointsParticipant', 'pointsOrganizer', 'targetAudience', 'semester', 'academicYear', 'status', 'creatorId', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 256 &&
             data.startTime is number &&
             data.endTime is number &&
             data.pointsParticipant is number &&
             data.pointsOrganizer is number &&
             data.targetAudience is string && data.targetAudience.size() >= 1 && data.targetAudience.size() <= 128 &&
             data.semester is number && data.semester >= 1 && data.semester <= 3 &&
             data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 64 &&
             data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
             data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.createdAt is number && data.updatedAt is number;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['userId', 'status']) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.status is string && data.status in ['registered', 'attended', 'organizer'];
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['title', 'message', 'targetAudience', 'createdAt']) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 256 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 1024 &&
             data.targetAudience is string && data.targetAudience.size() >= 1 && data.targetAudience.size() <= 128 &&
             data.createdAt is number;
    }

    function isValidHandbookTopic(data) {
      return data.keys().hasAll(['title', 'content', 'order']) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 256 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 65536 &&
             data.order is number;
    }

    function isValidYouthIdea(data) {
      return data.keys().hasAll(['userId', 'authorName', 'title', 'category', 'solutionProposal', 'status', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 256 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 512 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 128 &&
             data.solutionProposal is string && data.solutionProposal.size() >= 1 && data.solutionProposal.size() <= 16384 &&
             data.status is string && data.status in ['pending', 'approved', 'implemented', 'featured', 'rejected'] &&
             data.createdAt is number && data.updatedAt is number;
    }

    function isValidTnttApplication(data) {
      return data.keys().hasAll(['userId', 'applicantType', 'awardLevel', 'fullName', 'branch', 'primaryCategory', 'status', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.applicantType is string && data.applicantType in ['individual', 'collective'] &&
             data.awardLevel is string && data.awardLevel in ['truong', 'tieubieu'] &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 256 &&
             data.branch is string && data.branch.size() >= 1 && data.branch.size() <= 128 &&
             data.primaryCategory is string && data.primaryCategory.size() >= 1 && data.primaryCategory.size() <= 128 &&
             data.status is string && data.status in ['pending', 'approved_faculty', 'proposed_exemplary', 'needs_revision', 'rejected'] &&
             data.createdAt is number && data.updatedAt is number;
    }

    // --- Collections ---

    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if true;
      allow list: if true; // Allow reading for checking branch duplicates
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || isOwner(userId) || isBranchManager());
      allow delete: if isAdmin() || isOwner(userId) || isBranchManager();
    }

    match /bch_members/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn(); // All can read notifications intended for them (client filters for now)
      allow create: if isSignedIn() && isAdmin() && isValidNotification(incoming());
      allow update, delete: if isAdmin();
    }

    match /handbook_topics/{topicId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(topicId) && isValidHandbookTopic(incoming());
      allow update: if isAdmin() && isValidHandbookTopic(incoming());
      allow delete: if isAdmin();
    }

    match /youth_ideas/{ideaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(ideaId) && isValidYouthIdea(incoming()) && isOwner(incoming().userId);
      allow update: if isSignedIn() && isValidYouthIdea(incoming()) && (
        isAdmin() ||
        isBranchManager() ||
        isOwner(existing().userId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'upvotedBy', 'updatedAt'])
      );
      allow delete: if isAdmin() || isOwner(existing().userId);
    }

    match /tntt_applications/{applicationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(applicationId) && isValidTnttApplication(incoming()) && isOwner(incoming().userId) && incoming().status == 'pending';
      allow update: if isSignedIn() && isValidTnttApplication(incoming()) && (
        isAdmin() ||
        (isOwner(existing().userId) && incoming().status == 'pending')
      );
      allow delete: if isAdmin() || isOwner(existing().userId);
    }

    match /activities/{activityId} {
      allow read: if isSignedIn(); // All can read activities
      allow create: if isSignedIn() && isValidId(activityId) && isValidActivity(incoming()) && (
        isAdmin() ||
        (isBranchManager() && incoming().creatorId == request.auth.uid)
      );
      allow update: if isSignedIn() && isValidActivity(incoming()) && (
        isAdmin() ||
        (isBranchManager() && existing().creatorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'startTime', 'endTime', 'pointsParticipant', 'pointsOrganizer', 'targetAudience', 'semester', 'academicYear', 'planLink', 'evidenceLink', 'status', 'updatedAt']))
      );
      allow delete: if isAdmin() || (isBranchManager() && existing().creatorId == request.auth.uid);

      match /registrations/{registrationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && registrationId is string && registrationId.size() <= 128 && isValidRegistration(incoming()) && (
          (isOwner(incoming().userId) && incoming().status in ['registered', 'attended']) ||
          (isAdmin() && incoming().status in ['attended', 'organizer']) ||
          (isBranchManager() && incoming().status in ['attended', 'organizer'])
        );
        allow update: if isSignedIn() && isValidRegistration(incoming()) && (
          isAdmin() ||
          isBranchManager() ||
          (isOwner(existing().userId) && incoming().status in ['registered', 'attended'])
        );
        allow delete: if isAdmin() || isOwner(existing().userId) || isBranchManager();
      }
    }
  }
} // <EOF>
